# ================================
# Condor submission: AugSupCon nosparse d_model=128 — single run (seed 0)
#
# Phase 1: AugSupCon encoder, 12 classes (excl. DY_to_ll, Minbias_Soft_QCD, Upsilon_to_Leptons)
# Phase 2: Autoencoder anomaly detection (QCD vs Higgs), Trial 36 params
#
# Results:
#   Encoder     : /eos/user/d/dgenoves/anomaly_pipeline/logs/train/runs/<date>/
#   Anomaly     : /eos/user/d/dgenoves/anomaly_pipeline/strategies_v2/augsupcon_nosparse_dmodel128/seed_0/
#   MLflow      : /eos/user/d/dgenoves/anomaly_pipeline/logs/mlflow/mlruns/
#
# Usage:
#   condor_submit src/strategies_v2_nosparse_dmodel128.sub
# ================================

executable = src/wrapper_strategies_v2_nosparse_dmodel128.sh
arguments  = $(ClusterId)

# --- Logs ---
log_dir = /afs/cern.ch/user/d/dgenoves/foundation_model_testing_for_AD/logs/condor_logs
output  = $(log_dir)/strategies_v2_nosparse_dmodel128_$(ClusterId).out
error   = $(log_dir)/strategies_v2_nosparse_dmodel128_$(ClusterId).err
log     = $(log_dir)/strategies_v2_nosparse_dmodel128_$(ClusterId).log

run_as_owner = True
+JobFlavour  = "nextweek"
getenv       = True
request_cpus = 32
request_gpus = 1
Requirements = (TARGET.GPUs_GlobalMemoryMb >= 40000)

environment = "OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 SEED=42"

queue

# ================================
# Condor: SM acceptance at the QCD 10% AE threshold (scripts/xai/sm_acceptance.py)
#   condor_submit scripts/xai/submit/sm_acceptance.sub
# CPU only: one AE forward pass over 300,000 test embeddings per seed.
# ================================

executable = scripts/xai/submit/wrapper_sm_acceptance.sh
arguments  = $(ClusterId)

log_dir = /afs/cern.ch/user/d/dgenoves/foundation_model_testing_for_AD/logs/condor_logs/xai
output  = $(log_dir)/sm_acceptance_$(ClusterId).out
error   = $(log_dir)/sm_acceptance_$(ClusterId).err
log     = $(log_dir)/sm_acceptance_$(ClusterId).log

run_as_owner   = True
+JobFlavour    = "longlunch"
getenv         = True
request_cpus   = 4
request_memory = 16384
environment    = "OMP_NUM_THREADS=4 MKL_NUM_THREADS=4"

queue

# ================================
# Condor: linear probe evaluation — all models × all d_models
# Runs eval_probes.py on 10 seeds each, saves aggregated_summary.json
#
# Usage:
#   condor_submit src/eval_probes_all_dmodels.sub
# ================================

executable = src/wrapper_eval_probes_seeds.sh
arguments  = $(ClusterId)

log_dir = /afs/cern.ch/user/d/dgenoves/foundation_model_testing_for_AD/logs/condor_logs

run_as_owner = True
+JobFlavour  = "nextweek"
getenv       = True
request_cpus = 16
request_gpus = 1
Requirements = (TARGET.GPUs_GlobalMemoryMb >= 16000)

BASE_ENC = /eos/user/d/dgenoves/anomaly_pipeline/encoder_seeds
BASE_OUT = /eos/user/d/dgenoves/anomaly_pipeline/probe_results

# --- AugSupCon ---
EXPERIMENT = aug_supcon_12class_nosparse_dmodel32_cern
output  = $(log_dir)/eval_probes_$(EXPERIMENT)_$(ClusterId).out
error   = $(log_dir)/eval_probes_$(EXPERIMENT)_$(ClusterId).err
log     = $(log_dir)/eval_probes_$(EXPERIMENT)_$(ClusterId).log
environment = "OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 \
    EXPERIMENT=$(EXPERIMENT) \
    ENCODER_DIR=$(BASE_ENC)/$(EXPERIMENT) \
    OUTPUT_DIR=$(BASE_OUT)/$(EXPERIMENT) \
    N_SEEDS=10 SEED_START=0"
queue


# ================================
# Condor: AugSupCon 12class nosparse — encoder training + AE allsm
# for d_model=64 and d_model=32 (2 jobs)
#
# Each job: 10 encoder seeds × (phase1 training + phase2 AE allsm)
# BSM stats computed on all 12 SM classes.
#
# Usage:
#   condor_submit src/augsupcon_12class_nosparse_dmodels.sub
# ================================

executable = src/wrapper_encoder_seeds_allsm_augsupcon_dmodels.sh
arguments  = $(ClusterId)

log_dir = /afs/cern.ch/user/d/dgenoves/foundation_model_testing_for_AD/logs/condor_logs

run_as_owner = True
+JobFlavour  = "nextweek"
getenv       = True
request_cpus = 32
request_gpus = 1
Requirements = (TARGET.GPUs_GlobalMemoryMb >= 40000)

BASE_ENCODER = /eos/user/d/dgenoves/anomaly_pipeline/encoder_seeds
BASE_OUTPUT  = /eos/user/d/dgenoves/anomaly_pipeline/strategies_v2
N_SEEDS      = 10

# --- d_model=64 ---
PHASE1_EXPERIMENT = aug_supcon_12class_nosparse_dmodel64_cern
PHASE2_EXPERIMENT = anomaly_qcd_vs_higgs_embedding_augsupcon_nosparse_dmodel64_cern
output      = $(log_dir)/augsupcon_12class_nosparse_dmodel64_$(ClusterId).out
error       = $(log_dir)/augsupcon_12class_nosparse_dmodel64_$(ClusterId).err
log         = $(log_dir)/augsupcon_12class_nosparse_dmodel64_$(ClusterId).log
environment = "OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 \
    PHASE1_EXPERIMENT=$(PHASE1_EXPERIMENT) \
    PHASE2_EXPERIMENT=$(PHASE2_EXPERIMENT) \
    ENCODER_SEEDS_DIR=$(BASE_ENCODER)/$(PHASE1_EXPERIMENT) \
    OUTPUT_DIR=$(BASE_OUTPUT)/$(PHASE1_EXPERIMENT)_seeds \
    N_SEEDS=$(N_SEEDS)"
queue

# --- d_model=32 ---
PHASE1_EXPERIMENT = aug_supcon_12class_nosparse_dmodel32_cern
PHASE2_EXPERIMENT = anomaly_qcd_vs_higgs_embedding_augsupcon_nosparse_dmodel32_cern
output      = $(log_dir)/augsupcon_12class_nosparse_dmodel32_$(ClusterId).out
error       = $(log_dir)/augsupcon_12class_nosparse_dmodel32_$(ClusterId).err
log         = $(log_dir)/augsupcon_12class_nosparse_dmodel32_$(ClusterId).log
environment = "OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 \
    PHASE1_EXPERIMENT=$(PHASE1_EXPERIMENT) \
    PHASE2_EXPERIMENT=$(PHASE2_EXPERIMENT) \
    ENCODER_SEEDS_DIR=$(BASE_ENCODER)/$(PHASE1_EXPERIMENT) \
    OUTPUT_DIR=$(BASE_OUTPUT)/$(PHASE1_EXPERIMENT)_seeds \
    N_SEEDS=$(N_SEEDS)"
queue

# ================================
# Condor: raw AE allSM + QCD-only threshold (10 seeds)
# AE trained on all 12 SM classes, threshold from QCD only
#
# Usage:
#   condor_submit src/raw_baseline_allsm_qcdthresh.sub
# ================================

executable = src/wrapper_raw_baseline_allsm_qcdthresh.sh
arguments  = $(ClusterId)

log_dir = /afs/cern.ch/user/d/dgenoves/foundation_model_testing_for_AD/logs/condor_logs
output  = $(log_dir)/raw_allsm_qcdthresh_$(ClusterId).out
error   = $(log_dir)/raw_allsm_qcdthresh_$(ClusterId).err
log     = $(log_dir)/raw_allsm_qcdthresh_$(ClusterId).log

run_as_owner = True

+JobFlavour = "nextweek"

getenv       = True
request_cpus = 16
request_gpus = 1

Requirements = (TARGET.GPUs_GlobalMemoryMb >= 16000)

queue

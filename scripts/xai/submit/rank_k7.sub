# ================================
# Condor: the test that decides the XAI configuration.
#   condor_submit scripts/xai/submit/rank_k7.sub
#
# Occupancy, pairwise separation and ARI are all properties of the clustering. This
# is the only check that is a property of the paper's claim: with K=7 regions, does
# n_bjets still come out as the leading observable? It is rank 1 at K in
# {5,7,9,10,12,14} in the unprojected space, but has never been run in the projected
# one, and the projection rotates onto principal axes and discards 47% of the
# variance — so it has to be shown, not assumed.
#
# Two jobs, same K, same AE, same flagged events (the AE always scores the full
# 256-dimensional embedding; only the GMM assignment is projected). The pair
# therefore isolates the effect of the projection alone.
# ================================

executable = scripts/xai/submit/wrapper_rank_k7.sh
arguments  = $(ClusterId)

log_dir = /afs/cern.ch/user/d/dgenoves/foundation_model_testing_for_AD/logs/condor_logs/xai
output  = $(log_dir)/rank_k7_d256_$(TAG)_$(ClusterId).out
error   = $(log_dir)/rank_k7_d256_$(TAG)_$(ClusterId).err
log     = $(log_dir)/rank_k7_d256_$(TAG)_$(ClusterId).log

run_as_owner   = True
+JobFlavour    = "tomorrow"
getenv         = True
request_cpus   = 4
request_memory = 16384

SEED   = 3
DMODEL = 256
KVAL   = 7
environment = "SEED=$(SEED) DMODEL=$(DMODEL) KVAL=$(KVAL) PCADIM=$(PCADIM) OMP_NUM_THREADS=4 MKL_NUM_THREADS=4"

TAG = raw
PCADIM = 0
queue

TAG = pca64
PCADIM = 64
queue

# ================================
# Condor submission: GMM anomaly explanation
#
# Usage:
#   condor_submit src/gmm_explain.sub \
#       -a 'CKPT_PATH=/eos/user/d/dgenoves/anomaly_pipeline/encoder_seeds/aug_supcon_12class_nosparse_dmodel128_cern/seed_0/checkpoints/epoch_048.ckpt' \
#       -a 'OUTPUT_DIR=/eos/user/d/dgenoves/anomaly_pipeline/gmm_explain/augsupcon_nosparse_dmodel128_seed0'
# ================================

executable = src/wrapper_gmm_explain.sh
arguments  = $(ClusterId)

CKPT_PATH       =
SM_EXPERIMENT   = aug_supcon_12class_nosparse_dmodel128_cern
BSM_EXPERIMENT  = anomaly_qcd_vs_higgs_embedding_augsupcon_nosparse_dmodel128_cern
OUTPUT_DIR      = /eos/user/d/dgenoves/anomaly_pipeline/gmm_explain
K_VALUES        = 6,10,12,15,20
COV_TYPES       = diag
MAX_GMM_SAMPLES = 500000
MAX_EVENTS      =
SEED            = 42

# --- Logs ---
log_dir = /afs/cern.ch/user/d/dgenoves/foundation_model_testing_for_AD/logs/condor_logs
output  = $(log_dir)/gmm_explain_$(ClusterId).out
error   = $(log_dir)/gmm_explain_$(ClusterId).err
log     = $(log_dir)/gmm_explain_$(ClusterId).log

run_as_owner = True

+JobFlavour = "workday"

getenv       = True
request_cpus = 8
request_gpus = 1

Requirements = (TARGET.GPUs_GlobalMemoryMb >= 10000)

environment = "OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 \
    CKPT_PATH=$(CKPT_PATH) \
    SM_EXPERIMENT=$(SM_EXPERIMENT) \
    BSM_EXPERIMENT=$(BSM_EXPERIMENT) \
    OUTPUT_DIR=$(OUTPUT_DIR) \
    K_VALUES=$(K_VALUES) \
    COV_TYPES=$(COV_TYPES) \
    MAX_GMM_SAMPLES=$(MAX_GMM_SAMPLES) \
    MAX_EVENTS=$(MAX_EVENTS) \
    SEED=$(SEED)"

queue

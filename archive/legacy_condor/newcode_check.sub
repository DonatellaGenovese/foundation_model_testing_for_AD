# ================================
# Sanity check: train VCReg d128 seed 0 with new code
# and compare probe AUROC with existing old-code results.
#
# Usage:
#   condor_submit src/newcode_check.sub
# ================================

executable = src/wrapper_newcode_check.sh
arguments  = $(ClusterId)

log_dir = /afs/cern.ch/user/d/dgenoves/foundation_model_testing_for_AD/logs/condor_logs
output  = $(log_dir)/newcode_check_$(ClusterId).out
error   = $(log_dir)/newcode_check_$(ClusterId).err
log     = $(log_dir)/newcode_check_$(ClusterId).log

run_as_owner = True
+JobFlavour  = "nextweek"
getenv       = True
request_cpus = 32
request_gpus = 1
Requirements = (TARGET.GPUs_GlobalMemoryMb >= 40000)

queue

# ================================
# Condor: full-SM embedding extraction for the XAI pipeline (smnorm)
#   condor_submit scripts/xai/submit/extract_xai_emb.sub
#
# One job per d_model. Both are explained in the paper: d256 is the best AD model
# (HH4b TPR@FPR10 0.972 vs 0.900 for d128), d128 is the dimension the exploratory
# work was done in and serves as the robustness check on d_model.
# ================================

executable = scripts/xai/submit/wrapper_extract_xai_emb.sh
arguments  = $(ClusterId)

log_dir = /afs/cern.ch/user/d/dgenoves/foundation_model_testing_for_AD/logs/condor_logs/xai
output  = $(log_dir)/extract_xai_emb_d$(DMODEL)_seed$(SEED)_$(ClusterId).out
error   = $(log_dir)/extract_xai_emb_d$(DMODEL)_seed$(SEED)_$(ClusterId).err
log     = $(log_dir)/extract_xai_emb_d$(DMODEL)_seed$(SEED)_$(ClusterId).log

run_as_owner   = True
+JobFlavour    = "tomorrow"
getenv         = True
request_cpus   = 8
request_gpus   = 1
request_memory = 32768
Requirements   = (TARGET.GPUs_GlobalMemoryMb >= 16000)

SEED = 3
environment = "SEED=$(SEED) DMODEL=$(DMODEL) OMP_NUM_THREADS=8 MKL_NUM_THREADS=8"

queue DMODEL in (256 128)

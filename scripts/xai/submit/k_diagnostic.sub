# ================================
# Condor: K-selection diagnostic on a wide K grid, one job per d_model.
#   condor_submit scripts/xai/submit/k_diagnostic.sub
#
# CPU only — the GMM fits run in sklearn, no GPU involved. Writes to
# xai_paper/k_diagnostic/, so production 01_select_k/ results are untouched.
# ================================

executable = scripts/xai/submit/wrapper_k_diagnostic.sh
arguments  = $(ClusterId)

log_dir = /afs/cern.ch/user/d/dgenoves/foundation_model_testing_for_AD/logs/condor_logs/xai
output  = $(log_dir)/k_diag_d$(DMODEL)_seed$(SEED)_$(ClusterId).out
error   = $(log_dir)/k_diag_d$(DMODEL)_seed$(SEED)_$(ClusterId).err
log     = $(log_dir)/k_diag_d$(DMODEL)_seed$(SEED)_$(ClusterId).log

run_as_owner   = True
+JobFlavour    = "tomorrow"
getenv         = True
request_cpus   = 16
request_memory = 32768

SEED = 3
environment = "SEED=$(SEED) DMODEL=$(DMODEL) OMP_NUM_THREADS=16 MKL_NUM_THREADS=16"

queue DMODEL in (256 128)

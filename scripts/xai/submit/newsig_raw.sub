# ================================
# Condor: raw-feature autoencoder baseline on the HH->bbtautau proxy (newsig).
#   condor_submit scripts/xai/submit/newsig_raw.sub
#
# The Raw AE row of appendix Table 9 for HH->bbtautau. Same wrapper and strategy as
# case_raw.sub -- mse_qcd, inference only, the val-calibrated threshold stored in the
# checkpoint -- with only the dataset changed. Until this file existed that row had no
# submitter anywhere in the tree.
#
# The v3 newsig dataset must already exist: build it with
# scripts/prepare_newsig_smnorm.py before submitting.
#
# CPU is enough; the AE is a small MLP over 340 features and nothing is trained.
# ================================

executable = scripts/xai/submit/wrapper_case_raw.sh
arguments  = $(ClusterId)

log_dir = /afs/cern.ch/user/d/dgenoves/foundation_model_testing_for_AD/logs/condor_logs/xai
output  = $(log_dir)/newsig_raw_$(ClusterId).out
error   = $(log_dir)/newsig_raw_$(ClusterId).err
log     = $(log_dir)/newsig_raw_$(ClusterId).log

run_as_owner   = True
+JobFlavour    = "tomorrow"
getenv         = True
request_cpus   = 8
request_memory = 24576

# DATASET set explicitly: getenv would otherwise pass through whatever the submitting
# shell holds, and the wrapper defaults to case.
environment = "DATASET=newsig OMP_NUM_THREADS=8 MKL_NUM_THREADS=8"

queue
